# CHANGE BOTH before using the app; keep .env private
APP_PIN=change-this-pin
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PAYPAL_MODE=demo
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only required for real incoming webhook signature verification
PAYPAL_WEBHOOK_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: default false. Only for a private local demo.
ALLOW_DEMO_SEED=true

# Gmail SMTP: use a Google App Password, not your normal Gmail password.
# Leave blank until configured. NEVER commit .env or share this secret.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional BCC archive; leave blank to default to your own GMAIL_USER.
MAIL_COPY_TO=
# Local clock for automated reminders (IANA timezone). Default India.
MAIL_TIMEZONE=Asia/Kolkata
# Hard limit on automatic emails per local day (default 20)
MAIL_DAILY_CAP=20
